<a class="botao" onclick="chamarMotorista()">
Solicitar ajustes agora
</a>

<a class="voltar" href="vip.html">Voltar</a>

</div>

<script>
function chamarMotorista(){
    if (typeof fully !== "undefined") {
        fully.textToSpeech("O motorista já foi avisado para ajustar o conforto da viagem.");
    } else {
        alert("Informe ao motorista suas preferências de clima e itens.");
    }
}
</script>

